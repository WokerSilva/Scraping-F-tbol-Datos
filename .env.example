APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@TU_HOST:TU_PORT/railway
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

PIPELINE_MODE=historical
RUN_MODE=discovery_only
ACTIVE_LEAGUES=clausura_mexico
START_YEAR=2025
YEARS_BACK=1
BATCH_SIZE=10
SCRAPE_LIMIT=10

PERSIST=true
RESUME=true
ONLY_PENDING=true
FORCE_REFRESH=false
DRY_RUN=false

USE_BROWSER_FALLBACK=false
DEBUG_HTML=false
SAVE_RAW_PAGES=false
CACHE_ENABLED=true

REQUEST_TIMEOUT_SECONDS=30
REQUEST_DELAY_MIN_SECONDS=2.0
REQUEST_DELAY_MAX_SECONDS=5.0
MAX_CONCURRENCY=1
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=10

RUN_LOCK_ENABLED=true
RUN_LOCK_TTL_MINUTES=180